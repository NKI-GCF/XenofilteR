// ============================================================================
// src/region/ambiguous.rs  — BED padding for indel expansion
// ============================================================================

use crate::region::scored::ScoredRegions;

impl ScoredRegions {
    /// Return a copy of these regions with each interval expanded by
    /// `padding` bases on both sides (clamped at 0).
    ///
    /// Used when `--expand-indels` is active to ensure that reads whose
    /// aligner placed an indel outside the annotated BED boundary are still
    /// caught and forced through full NW scoring.
    pub(crate) fn with_indel_padding(&self, padding: usize) -> ScoredRegions {
        let per_ref = self
            .per_ref
            .iter()
            .map(|bucket| {
                bucket
                    .iter()
                    .map(|r| crate::region::scored::ScoredRegion {
                        ref_id: r.ref_id,
                        start:  r.start.saturating_sub(padding),
                        end:    r.end.saturating_add(padding),
                        score:  r.score,
                        strand: r.strand,
                    })
                    .collect()
            })
            .collect();
        ScoredRegions { per_ref }
    }
}

/// Load ambiguous-region BED files with optional indel-expansion padding.
pub(crate) fn load_ambiguous_regions_with_padding(
    specs:      &[String],
    name_to_id: &std::collections::HashMap<String, usize>,
    padding:    usize,
) -> Result<[Option<ScoredRegions>; 2]> {
    let raw: [Option<ScoredRegions>; 2] = [
        specs.get(0)
            .filter(|s| !s.is_empty())
            .map(|s| ScoredRegions::from_bed(std::path::Path::new(s), name_to_id))
            .transpose()?,
        specs.get(1)
            .filter(|s| !s.is_empty())
            .map(|s| ScoredRegions::from_bed(std::path::Path::new(s), name_to_id))
            .transpose()?,
    ];
    if padding == 0 {
        return Ok(raw);
    }
    Ok([
        raw[0].as_ref().map(|r| r.with_indel_padding(padding)),
        raw[1].as_ref().map(|r| r.with_indel_padding(padding)),
    ])
}
