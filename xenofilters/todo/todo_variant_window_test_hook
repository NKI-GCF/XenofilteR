// ============================================================================
// src/region/diagnostic.rs  — updated SegregateVariants with overlaps()
//
// Minor addition: `is_reverse` parameter forwarded for strand-aware overlap.
// The body is otherwise unchanged from the existing implementation.
// ============================================================================

#[derive(Debug, Clone)]
pub(crate) struct DiagnosticSite {
    pub(crate) pos:     usize,   // 0-based
    pub(crate) ref_len: usize,
}

impl DiagnosticSite {
    #[inline]
    pub(crate) fn end(&self) -> usize {
        self.pos + self.ref_len
    }
}

#[derive(Debug, Clone, Default)]
pub(crate) struct SegregateVariants {
    /// per_ref[ref_id] = sorted-by-pos Vec<DiagnosticSite>
    pub(crate) per_ref: Vec<Vec<DiagnosticSite>>,
}

impl SegregateVariants {
    /// True when any site on chromosome `ref_id` overlaps `[start, end)`.
    ///
    /// `is_reverse` is accepted for API consistency with `ScoredRegions`
    /// but diagnostic sites are strand-agnostic (no BED column 6).
    #[inline]
    pub(crate) fn overlaps(
        &self,
        ref_id:       usize,
        start:        usize,
        end:          usize,
        _is_reverse:  bool,
    ) -> bool {
        let Some(bucket) = self.per_ref.get(ref_id) else { return false };
        // Binary search to the first site whose end might be > start.
        let lo = bucket.partition_point(|s| s.end() <= start);
        bucket[lo..].iter().take_while(|s| s.pos < end).any(|s| s.end() > start)
    }

    /// Build from a pre-computed per_ref structure (used by tests and
    /// diagnostic_equiv.rs).
    pub(crate) fn from_per_ref(per_ref: Vec<Vec<DiagnosticSite>>) -> Self {
        Self { per_ref }
    }

    /// Load from a plain (non-expanded) VCF/BCF file.
    /// Called when --expand-indels is off.
    pub(crate) fn from_vcf(
        path:       &std::path::Path,
        name_to_id: &std::collections::HashMap<String, usize>,
    ) -> anyhow::Result<Self> {
        use std::{fs::File, io::BufReader};
        use noodles::vcf;
        use anyhow::Context;

        let mut reader = vcf::io::Reader::new(BufReader::new(File::open(path)?));
        let header     = reader.read_header()?;
        let mut per_ref: Vec<Vec<DiagnosticSite>> = Vec::new();

        for result in reader.record_bufs(&header) {
            let rec     = result?;
            let chrom   = rec.reference_sequence_name().to_string();
            let ref_id  = match name_to_id.get(&chrom) {
                Some(&id) => id,
                None      => continue,
            };
            let pos_0 = rec
                .variant_start()
                .transpose()
                .context("variant_start")?
                .map(|p| p.get() - 1)
                .unwrap_or(0);
            let ref_len = rec.reference_bases().len();

            if per_ref.len() <= ref_id {
                per_ref.resize_with(ref_id + 1, Vec::new);
            }
            per_ref[ref_id].push(DiagnosticSite { pos: pos_0, ref_len });
        }

        for bucket in &mut per_ref {
            bucket.sort_unstable_by_key(|s| s.pos);
        }
        Ok(Self { per_ref })
    }
}


