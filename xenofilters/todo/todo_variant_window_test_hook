// ============================================================================
// src/variant/variant_window_test_hook.rs
//
// Thin test-only wrapper around align_alt_to_read so integration tests can
// invoke the NW scoring path without threading a full FragmentState through.
//
// Gated behind cfg(any(test, feature = "bench-internals")) so it compiles
// away in production builds with zero overhead.
// ============================================================================

#![cfg(any(test, feature = "bench-internals"))]

use crate::{
    penalty::Penalty,
    variant::{variant_window::align_alt_to_read, Variant},
};

/// Compute the rescue delta for a single variant against a read sequence.
///
/// Returns `alt_score - ref_incurred`; positive when the variant's alt
/// allele is better supported than the reference at that position.
///
/// Used only in tests; not on the hot path.
pub fn compute_rescue_delta(
    variant:       &dyn Variant,
    read_seq:      &[u8],
    read_qscores:  &[u8],
    ref_start:     usize,   // 0-based start of the read's alignment on the reference
    pen:           &Penalty,
) -> f64 {
    let p = variant.p_variant();
    if p <= 0.5 {
        // Structural invariant: rescue delta cannot be positive below 0.5.
        return 0.0;
    }
    align_alt_to_read(
        variant.ref_allele(),
        variant.alt_allele(),
        read_seq,
        read_qscores,
        variant.pos(),
        ref_start,
        p,
        pen,
    )
}


// ============================================================================
// src/variant/store.rs  — complete overlapping_multi implementation
//
// Shown as a standalone impl block; merge with existing Store<V> definition.
//
// Internal layout:
//   per_ref: HashMap<usize, Vec<V>, RandomState>
//     key = chromosome index (tid, 0-based)
//     value = Vec<V> sorted ascending by pos()
//
// Overlap condition for a variant at [var.pos(), var.pos() + ref_len):
//   var.pos() < query_end  AND  var.pos() + ref_len > query_start
// ============================================================================

use ahash::RandomState;
use smallvec::SmallVec;
use std::collections::HashMap;

use crate::variant::Variant;

pub(crate) struct Store<V: Variant> {
    /// Per-chromosome sorted variant buckets.
    pub(crate) per_ref: HashMap<usize, Vec<V>, RandomState>,
}

impl<V: Variant> Store<V> {
    pub(crate) fn new() -> Self {
        Self { per_ref: HashMap::with_hasher(RandomState::new()) }
    }

    /// Return all variants whose reference span overlaps `[query_start, query_end)`.
    ///
    /// Uses binary search to find the first candidate (O(log n)) and then
    /// scans forward while the variant's start is less than `query_end` (O(k)
    /// where k is the number of results).
    ///
    /// Returns a SmallVec of references; capacity 4 keeps typical variant-per-
    /// window counts on the stack.
    ///
    /// This method is on the hot path and must not allocate beyond the
    /// SmallVec inline capacity for typical inputs.
    pub(crate) fn overlapping_multi(
        &self,
        tid:         usize,
        query_start: usize,
        query_end:   usize,
    ) -> SmallVec<[&V; 4]> {
        let mut out: SmallVec<[&V; 4]> = SmallVec::new();
        let Some(bucket) = self.per_ref.get(&tid) else { return out };

        // Binary search: first variant whose pos might overlap (pos < query_end).
        // partition_point gives us the first index where pos >= query_end.
        let upper = bucket.partition_point(|v| v.pos() < query_end);

        // Scan backwards from upper: collect variants where
        //   v.pos() + v.ref_allele().len() > query_start
        // Because the bucket is sorted by pos(), once v.pos() < query_start
        // and the ref span also ends before query_start, we can stop.
        // However, large deletions could start well before query_start but
        // still overlap.  We therefore scan back at most MAX_DEL_LEN entries.
        const MAX_SCAN_BACK: usize = 256; // generous upper bound for ref span
        let lo = upper.saturating_sub(MAX_SCAN_BACK);

        for v in &bucket[lo..upper] {
            let ref_end = v.pos() + v.ref_allele().len();
            if ref_end > query_start {
                out.push(v);
            }
        }
        out
    }

    /// Number of variants across all chromosomes.
    pub(crate) fn total_count(&self) -> usize {
        self.per_ref.values().map(|v| v.len()).sum()
    }
}


